<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0"
  xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0"
  id="Definitions_Papillon" targetNamespace="https://github.com/valenzuelagustavo/papillon-etl-nexus">
<bpmn:collaboration id="Collab_Registro">
  <bpmn:participant id="P_editorial" name="Editorial / Distribuidora" />
  <bpmn:participant id="P_papillon" name="Papillon Libros S.A. — Registro de facturas y notas de crédito" processRef="Proc_papillon" />
  <bpmn:messageFlow id="m1" name="Declaración de ventas" sourceRef="T_env" targetRef="P_editorial" />
<bpmn:messageFlow id="m2" name="Factura de liquidación PDF" sourceRef="P_editorial" targetRef="C_fact" />
<bpmn:messageFlow id="m3" name="Factura en firme o nota de crédito PDF" sourceRef="P_editorial" targetRef="S_nc" />
<bpmn:messageFlow id="m4" name="Solicitud de corrección o refacturación" sourceRef="End_sol" targetRef="P_editorial" />
</bpmn:collaboration>
<bpmn:process id="Proc_papillon" name="Registro de facturas de consignación y notas de crédito" isExecutable="false">
<bpmn:laneSet id="LaneSet_1">
<bpmn:lane id="L_compras" name="Comercial y Compras"><bpmn:flowNodeRef>S_mes</bpmn:flowNodeRef><bpmn:flowNodeRef>T_decl</bpmn:flowNodeRef><bpmn:flowNodeRef>T_env</bpmn:flowNodeRef><bpmn:flowNodeRef>C_fact</bpmn:flowNodeRef><bpmn:flowNodeRef>S_nc</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>T_eq</bpmn:flowNodeRef><bpmn:flowNodeRef>T_sol</bpmn:flowNodeRef><bpmn:flowNodeRef>End_sol</bpmn:flowNodeRef><bpmn:flowNodeRef>T_imp</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_etl" name="Middleware ETL (sistema)"><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>T3</bpmn:flowNodeRef><bpmn:flowNodeRef>T4</bpmn:flowNodeRef><bpmn:flowNodeRef>Gt</bpmn:flowNodeRef><bpmn:flowNodeRef>T_conc</bpmn:flowNodeRef><bpmn:flowNodeRef>T_nc</bpmn:flowNodeRef><bpmn:flowNodeRef>T5</bpmn:flowNodeRef><bpmn:flowNodeRef>G2</bpmn:flowNodeRef><bpmn:flowNodeRef>T6</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_nexus" name="Sistema Nexus"><bpmn:flowNodeRef>T10</bpmn:flowNodeRef><bpmn:flowNodeRef>G4</bpmn:flowNodeRef><bpmn:flowNodeRef>End_ok</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_admin" name="Administración"><bpmn:flowNodeRef>T7</bpmn:flowNodeRef><bpmn:flowNodeRef>G3</bpmn:flowNodeRef><bpmn:flowNodeRef>T8</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:dataObject id="Obj_decl" />
<bpmn:dataObject id="Obj_eq" />
<bpmn:dataObject id="Obj_pdf" />
<bpmn:dataObject id="Obj_rem" />
<bpmn:dataObject id="Obj_xlsx" />
<bpmn:startEvent id="S_mes" name="Cierre de mes"><bpmn:outgoing>f1</bpmn:outgoing><bpmn:timerEventDefinition id="S_mes_d"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1M</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
<bpmn:userTask id="T_decl" name="Elaborar declaración de ventas en consignación"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing><bpmn:dataOutputAssociation id="a_decl1"><bpmn:targetRef>DO_decl1</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask>
<bpmn:sendTask id="T_env" name="Enviar declaración a la editorial"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:sendTask>
<bpmn:intermediateCatchEvent id="C_fact" name="Factura de liquidación recibida"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing><bpmn:messageEventDefinition id="C_fact_d" /></bpmn:intermediateCatchEvent>
<bpmn:startEvent id="S_nc" name="Factura en firme o nota de crédito recibida"><bpmn:outgoing>f5</bpmn:outgoing><bpmn:messageEventDefinition id="S_nc_d" /></bpmn:startEvent>
<bpmn:userTask id="T1" name="Cargar comprobante PDF en el middleware"><bpmn:incoming>f4</bpmn:incoming><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="T_eq" name="Registrar nueva equivalencia ISBN"><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing></bpmn:userTask>
<bpmn:sendTask id="T_sol" name="Solicitar a la editorial la corrección del comprobante"><bpmn:incoming>f23</bpmn:incoming><bpmn:outgoing>f25</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="End_sol" name="Corrección solicitada"><bpmn:incoming>f25</bpmn:incoming><bpmn:messageEventDefinition id="End_sol_d" /></bpmn:endEvent>
<bpmn:userTask id="T_imp" name="Importar XLSX en Nexus indicando el tipo de comprobante"><bpmn:incoming>f26</bpmn:incoming><bpmn:outgoing>f27</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="T2" name="Identificar editorial y tipo de comprobante"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing><bpmn:property id="a_pdf_p" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="a_pdf"><bpmn:sourceRef>DO_pdf</bpmn:sourceRef><bpmn:targetRef>a_pdf_p</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G1" name="¿Formato reconocido?"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing><bpmn:outgoing>f9</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:scriptTask id="T3" name="Extraer datos del comprobante"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:scriptTask>
<bpmn:businessRuleTask id="T4" name="Resolver códigos editoriales a ISBN"><bpmn:incoming>f10</bpmn:incoming><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing><bpmn:property id="a_eq_p" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="a_eq"><bpmn:sourceRef>DO_eq</bpmn:sourceRef><bpmn:targetRef>a_eq_p</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="Gt" name="¿Tipo de comprobante?"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing><bpmn:outgoing>f13</bpmn:outgoing><bpmn:outgoing>f13b</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:businessRuleTask id="T_conc" name="Conciliar liquidación con la declaración de ventas"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing><bpmn:property id="a_decl2_p" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="a_decl2"><bpmn:sourceRef>DO_decl2</bpmn:sourceRef><bpmn:targetRef>a_decl2_p</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:businessRuleTask>
<bpmn:businessRuleTask id="T_nc" name="Cruzar nota de crédito con remitos de devolución"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing><bpmn:property id="a_rem_p" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="a_rem"><bpmn:sourceRef>DO_rem</bpmn:sourceRef><bpmn:targetRef>a_rem_p</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:businessRuleTask>
<bpmn:scriptTask id="T5" name="Validar datos del comprobante"><bpmn:incoming>f13b</bpmn:incoming><bpmn:incoming>f14</bpmn:incoming><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing></bpmn:scriptTask>
<bpmn:exclusiveGateway id="G2" name="¿Resultado de la validación?"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing><bpmn:outgoing>f18</bpmn:outgoing><bpmn:outgoing>f20</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:scriptTask id="T6" name="Generar archivo XLSX para Nexus"><bpmn:incoming>f17</bpmn:incoming><bpmn:incoming>f24</bpmn:incoming><bpmn:outgoing>f26</bpmn:outgoing><bpmn:dataOutputAssociation id="a_xlsx"><bpmn:targetRef>DO_xlsx</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:scriptTask>
<bpmn:serviceTask id="T10" name="Registrar comprobante y actualizar stock según el código"><bpmn:incoming>f27</bpmn:incoming><bpmn:outgoing>f27b</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G4" name="¿Importación exitosa?"><bpmn:incoming>f27b</bpmn:incoming><bpmn:outgoing>f28</bpmn:outgoing><bpmn:outgoing>f29</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_ok" name="Comprobante registrado"><bpmn:incoming>f28</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="T7" name="Revisar comprobante manualmente"><bpmn:incoming>f9</bpmn:incoming><bpmn:incoming>f20</bpmn:incoming><bpmn:incoming>f29</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G3" name="¿Origen de la diferencia?"><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f22</bpmn:outgoing><bpmn:outgoing>f23</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="T8" name="Corregir datos extraídos"><bpmn:incoming>f22</bpmn:incoming><bpmn:outgoing>f24</bpmn:outgoing></bpmn:userTask>
<bpmn:dataObjectReference id="DO_decl1" name="Declaración de ventas" dataObjectRef="Obj_decl" />
<bpmn:dataObjectReference id="DO_decl2" name="Declaración de ventas" dataObjectRef="Obj_decl" />
<bpmn:dataObjectReference id="DO_pdf" name="Comprobante PDF" dataObjectRef="Obj_pdf" />
<bpmn:dataObjectReference id="DO_eq" name="Tabla EquivalenciaISBN" dataObjectRef="Obj_eq" />
<bpmn:dataObjectReference id="DO_rem" name="Remitos de devolución" dataObjectRef="Obj_rem" />
<bpmn:dataObjectReference id="DO_xlsx" name="Archivo XLSX Nexus" dataObjectRef="Obj_xlsx" />
<bpmn:textAnnotation id="A0"><bpmn:text>Material en consignación: la editorial factura solo lo declarado como vendido en el mes</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="A_nc"><bpmn:text>Facturas en firme (compras que no son en consignación) y notas de crédito por devoluciones o errores de facturación</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="A_mej"><bpmn:text>Mejora propuesta por el proyecto: conciliación automática</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="A1"><bpmn:text>HU-01 · M1: lote de hasta 10 PDF en menos de 15 s</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="A2"><bpmn:text>HU-02 · M2: precisión ≥ 98 % en ISBN, precio y cantidad</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="A3"><bpmn:text>HU-03 · El comprobante queda en estado Pendiente o Error hasta su revisión</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="A4"><bpmn:text>M4: 100 % de los XLSX importados sin errores de formato</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="A5"><bpmn:text>La editorial reenvía una factura corregida o emite una nota de crédito, que ingresa como un nuevo comprobante</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="A6"><bpmn:text>El código de tipo de comprobante define el movimiento de stock en Nexus (10: factura en firme, suma al stock; 19: liquidación de venta, baja el stock consignado). La cantidad siempre es un entero positivo.</bpmn:text></bpmn:textAnnotation>
